{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["title", "description", "product", "audience", "owner", "status", "verified_at", "evidence"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 10},
    "product": {"enum": ["platform", "guestweave", "hostweave", "imageweave", "agent-core", "agent-modules", "documentation"]},
    "audience": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["consumer", "developer", "operator", "contributor"]}},
    "owner": {"type": "string", "minLength": 1},
    "status": {"enum": ["code-inspected", "runtime-verified", "draft"]},
    "verified_at": {"type": "string", "format": "date"},
    "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*:.+"}},
    "slug": {"type": "string"},
    "sidebar_position": {"type": "integer"}
  },
  "additionalProperties": false
}
